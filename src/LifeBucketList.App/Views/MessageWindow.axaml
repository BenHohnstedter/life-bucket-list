<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LifeBucketList.App.Views.MessageWindow"
        x:Name="Root"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Classes="dialog">
    <StackPanel Classes="dialog-content">
        <TextBlock Text="{Binding #Root.MessageTitle}" Classes="dialog-title" />
        <TextBlock Text="{Binding #Root.Message}" TextWrapping="Wrap" Classes="dialog-message" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Classes="dialog-buttons">
            <Button Content="OK" Classes="primary" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
