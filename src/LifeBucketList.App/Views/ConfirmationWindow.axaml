<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LifeBucketList.App.Views.ConfirmationWindow"
        x:Name="Root"
        Width="380"
        Classes="dialog">
    <StackPanel Classes="dialog-content">
        <TextBlock Text="{Binding #Root.QuestionTitle}" Classes="dialog-title" />
        <TextBlock Text="{Binding #Root.Message}" TextWrapping="Wrap" Classes="dialog-message" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Classes="dialog-buttons">
            <Button Content="Abbrechen" Classes="secondary" Click="OnNoClick" />
            <Button Content="Ja" Classes="primary" Click="OnYesClick" />
        </StackPanel>
    </StackPanel>
</Window>
