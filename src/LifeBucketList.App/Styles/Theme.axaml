<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AppBackgroundColor">#F5F5F7</Color>
                    <Color x:Key="SurfaceColor">#FFFFFF</Color>
                    <Color x:Key="BorderColor">#E1E1E6</Color>
                    <Color x:Key="TextPrimaryColor">#1D1D1F</Color>
                    <Color x:Key="TextSecondaryColor">#6E6E73</Color>
                    <Color x:Key="AccentColor">#0A84FF</Color>
                    <Color x:Key="AccentHoverColor">#0071E3</Color>
                    <Color x:Key="DangerColor">#E0342A</Color>
                    <Color x:Key="DangerHoverColor">#C22A21</Color>
                    <Color x:Key="StarFilledColor">#FFB000</Color>
                    <Color x:Key="StarEmptyColor">#D1D1D6</Color>
                    <Color x:Key="ControlHoverColor">#F0F0F2</Color>

                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="BorderBrush1" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
                    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
                    <SolidColorBrush x:Key="StarFilledBrush" Color="{StaticResource StarFilledColor}" />
                    <SolidColorBrush x:Key="StarEmptyBrush" Color="{StaticResource StarEmptyColor}" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />

                    <Color x:Key="ControlPressedColor">#E4E4E8</Color>
                    <Color x:Key="AccentPressedColor">#005BBF</Color>
                    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
                    <Color x:Key="DisabledTextColor">#C6C6C9</Color>
                    <Color x:Key="DisabledSurfaceColor">#F0F0F2</Color>
                    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
                    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
                    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
                    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="{StaticResource DisabledSurfaceColor}" />

                    <!-- Re-skin stock FluentTheme controls (ComboBox popup, Calendar flyout, ToggleSwitch)
                         so they match this custom palette instead of looking like unstyled default Fluent
                         dropped into a custom shell. Key names verified against the installed
                         Avalonia.Themes.Fluent 11.3.20 assembly. -->
                    <Color x:Key="SystemAccentColor">#0A84FF</Color>
                    <Color x:Key="SystemAccentColorLight1">#3A9DFF</Color>
                    <Color x:Key="SystemAccentColorLight2">#6BB6FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#9CCFFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#0071E3</Color>
                    <Color x:Key="SystemAccentColorDark2">#005BBF</Color>
                    <Color x:Key="SystemAccentColorDark3">#00459A</Color>

                    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{StaticResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource ControlHoverColor}" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource ControlHoverColor}" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource ControlHoverColor}" />
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource TextPrimaryColor}" />

                    <SolidColorBrush x:Key="CalendarViewBackground" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="CalendarViewForeground" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="CalendarViewCalendarItemForeground" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="CalendarViewSelectedBorderBrush" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="CalendarViewSelectedHoverBorderBrush" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="CalendarViewPressedBorderBrush" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="CalendarViewHoverBorderBrush" Color="{StaticResource ControlHoverColor}" />
                    <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="CalendarViewOutOfScopeForeground" Color="{StaticResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="DatePickerFlyoutPresenterBackground" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="DatePickerFlyoutPresenterBorderBrush" Color="{StaticResource BorderColor}" />

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentHoverColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource TextOnAccentColor}" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AppBackgroundColor">#1C1C1E</Color>
                    <Color x:Key="SurfaceColor">#2C2C2E</Color>
                    <Color x:Key="BorderColor">#3A3A3C</Color>
                    <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
                    <Color x:Key="TextSecondaryColor">#A1A1A6</Color>
                    <Color x:Key="AccentColor">#0A84FF</Color>
                    <Color x:Key="AccentHoverColor">#409CFF</Color>
                    <Color x:Key="DangerColor">#FF453A</Color>
                    <Color x:Key="DangerHoverColor">#FF6961</Color>
                    <Color x:Key="StarFilledColor">#FFD60A</Color>
                    <Color x:Key="StarEmptyColor">#48484A</Color>
                    <!-- Was #3A3A3C, identical to BorderColor below it — hover states were literally
                         invisible against a border-colored surface in dark mode. -->
                    <Color x:Key="ControlHoverColor">#454548</Color>

                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="BorderBrush1" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
                    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
                    <SolidColorBrush x:Key="StarFilledBrush" Color="{StaticResource StarFilledColor}" />
                    <SolidColorBrush x:Key="StarEmptyBrush" Color="{StaticResource StarEmptyColor}" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />

                    <Color x:Key="ControlPressedColor">#504F53</Color>
                    <Color x:Key="AccentPressedColor">#6AB4FF</Color>
                    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
                    <Color x:Key="DisabledTextColor">#6E6E73</Color>
                    <Color x:Key="DisabledSurfaceColor">#333335</Color>
                    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
                    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
                    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
                    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="{StaticResource DisabledSurfaceColor}" />

                    <Color x:Key="SystemAccentColor">#0A84FF</Color>
                    <Color x:Key="SystemAccentColorLight1">#409CFF</Color>
                    <Color x:Key="SystemAccentColorLight2">#6AB4FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#94CCFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#0071E3</Color>
                    <Color x:Key="SystemAccentColorDark2">#005BBF</Color>
                    <Color x:Key="SystemAccentColorDark3">#00459A</Color>

                    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{StaticResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource ControlHoverColor}" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource ControlHoverColor}" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource ControlHoverColor}" />
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource TextPrimaryColor}" />

                    <SolidColorBrush x:Key="CalendarViewBackground" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="CalendarViewForeground" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="CalendarViewCalendarItemForeground" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="CalendarViewSelectedBorderBrush" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="CalendarViewSelectedHoverBorderBrush" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="CalendarViewPressedBorderBrush" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="CalendarViewHoverBorderBrush" Color="{StaticResource ControlHoverColor}" />
                    <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="CalendarViewOutOfScopeForeground" Color="{StaticResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="DatePickerFlyoutPresenterBackground" Color="{StaticResource SurfaceColor}" />
                    <SolidColorBrush x:Key="DatePickerFlyoutPresenterBorderBrush" Color="{StaticResource BorderColor}" />

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentHoverColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource TextOnAccentColor}" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- Non-color design tokens: not theme-dependent, so they live outside ThemeDictionaries. -->
            <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
            <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">16</CornerRadius>

            <x:Double x:Key="FontSizeCaption">12</x:Double>
            <x:Double x:Key="FontSizeBody">13</x:Double>
            <x:Double x:Key="FontSizeBodyStrong">14</x:Double>
            <x:Double x:Key="FontSizeSubtitle">16</x:Double>
            <x:Double x:Key="FontSizeTitle">20</x:Double>
            <x:Double x:Key="FontSizeLargeTitle">28</x:Double>

            <Thickness x:Key="ButtonPadding">16,9</Thickness>
            <Thickness x:Key="SmallButtonPadding">10,5</Thickness>
            <Thickness x:Key="InputPadding">12,8</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Window & base -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="TransparencyLevelHint" Value="None" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Header -->
    <Style Selector="Border.app-header">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="24,16" />
    </Style>
    <Style Selector="TextBlock.app-title">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Tab strip -->
    <Style Selector="Border.tab-strip-container">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,0" />
    </Style>
    <Style Selector="ListBox.tab-strip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.tab-strip ListBoxItem">
        <Setter Property="Padding" Value="14,16" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.tab-strip ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tab-strip ListBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="14,16" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tab-item.selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tab-add-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="12,16" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tab-add-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Button.small">
        <Setter Property="Padding" Value="{StaticResource SmallButtonPadding}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource DangerHoverBrush}" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    </Style>
    <Style Selector="Button.date-field-trigger">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource InputPadding}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.date-field-trigger.placeholder">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.date-field-trigger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Button.date-field-trigger:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Toolbar -->
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="24,14" />
    </Style>

    <!-- Entry cards -->
    <Style Selector="Border.entry-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.entry-title">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.entry-meta">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.entry-note">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.empty-hint">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,48,0,0" />
    </Style>

    <!-- Cover images -->
    <Style Selector="Image.cover-thumb">
        <Setter Property="Width" Value="84" />
        <Setter Property="Height" Value="120" />
        <Setter Property="Stretch" Value="UniformToFill" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Image.cover-preview">
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.cover-result">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.cover-result:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.cover-result:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- World map -->
    <Style Selector="Border.world-map-frame">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Dashboard -->
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.stat-number">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLargeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ProgressBar.stat-bar">
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Dialogs -->
    <Style Selector="StackPanel.dialog-content">
        <Setter Property="Margin" Value="24" />
        <Setter Property="Spacing" Value="16" />
    </Style>
    <Style Selector="TextBlock.dialog-title">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.dialog-message">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="StackPanel.field">
        <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="TextBlock.field-label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.validation-error">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    </Style>
    <Style Selector="StackPanel.dialog-buttons">
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

</Styles>
